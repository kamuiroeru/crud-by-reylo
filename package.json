    "typescript": "^7.1.0-beta"
  },
  "dependencies": {
    "@reylosql/sqlite": "^0.6.0",
    "reylo": "^0.6.0",
    "sqlite3": "^6.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
